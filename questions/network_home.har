            "mimeType": "text/javascript",
            "compression": 0,
            "text": "const normalizePath = (path)=>{\n    if (!path) return null;\n    if (!path.startsWith('/')) return null;\n    if (path.startsWith('//')) return null;\n    return path;\n};\nconst parsePathAndQuery = (value)=>{\n    if (value.startsWith('/')) {\n        const [pathPart, query = ''] = value.split('?');\n        return {\n            path: normalizePath(pathPart),\n            params: new URLSearchParams(query)\n        };\n    }\n    const query = value.startsWith('?') ? value.slice(1) : value;\n    return {\n        path: null,\n        params: new URLSearchParams(query)\n    };\n};\nconst parseLiffStateValue = (raw)=>{\n    if (!raw) return {\n        path: null,\n        params: new URLSearchParams()\n    };\n    let decoded = raw;\n    try {\n        decoded = decodeURIComponent(raw);\n    } catch  {\n    // If decode fails, fall back to the raw value.\n    }\n    if (/^https?:\\/\\//i.test(decoded)) {\n        try {\n            const url = new URL(decoded);\n            return {\n                path: normalizePath(url.pathname),\n                params: new URLSearchParams(url.search)\n            };\n        } catch  {\n            return {\n                path: null,\n                params: new URLSearchParams()\n            };\n        }\n    }\n    const hashIndex = decoded.indexOf('#');\n    if (hashIndex >= 0) {\n        const afterHash = decoded.slice(hashIndex + 1);\n        if (afterHash) {\n            return parsePathAndQuery(afterHash);\n        }\n    }\n    return parsePathAndQuery(decoded);\n};\nconst routeForTab = (tabName, role)=>{\n    switch(tabName){\n        case 'dashboard':\n            return role === 'market' ? '/market' : '/farmer';\n        case 'products':\n            return role === 'market' ? '/market/products' : '/farmer/products';\n        case 'stores':\n            return role === 'market' ? '/market/farms' : '/farmer/stores';\n        case 'marketing':\n            return role === 'market' ? '/market' : '/farmer/marketing';\n        case 'analytics':\n            return role === 'market' ? '/market/ratings' : '/farmer/analytics';\n        case 'settings':\n            return '/settings';\n        default:\n            return null;\n    }\n};\nexport const resolveDeepLinkTarget = (search, userRole)=>{\n    const params = new URLSearchParams(search);\n    const { path: liffPath, params: liffParams } = parseLiffStateValue(params.get('liff.state'));\n    const getParam = (key)=>params.get(key) ?? liffParams.get(key);\n    let tab = getParam('tab');\n    const action = getParam('action');\n    let role = getParam('role');\n    const product = getParam('product');\n    const isEditAction = action === 'edit';\n    // Allow product-only deep links to resolve to the catalog.\n    if (!tab && product && !isEditAction) {\n        tab = 'products';\n    }\n    if (liffPath && liffPath !== '/') {\n        const mergedParams = new URLSearchParams(liffParams);\n        if (action && !mergedParams.get('action')) mergedParams.set('action', action);\n        if (role && !mergedParams.get('role')) mergedParams.set('role', role);\n        if (product && !mergedParams.get('product')) mergedParams.set('product', product);\n        const query = mergedParams.toString();\n        return query ? `${liffPath}?${query}` : liffPath;\n    }\n    if (!tab) return null;\n    // If a specific product is being opened from LINE, force the market storefront.\n    if (product && !isEditAction) {\n        role = 'market';\n    }\n    const resolvedRole = userRole || role || null;\n    const target = routeForTab(tab, resolvedRole);\n    if (!target) return null;\n    const nextParams = new URLSearchParams();\n    if (action) nextParams.set('action', action);\n    // Preserve role if provided in query and user role is not known.\n    if (!userRole && resolvedRole) nextParams.set('role', resolvedRole);\n    if (product) nextParams.set('product', product);\n    const query = nextParams.toString();\n    return query ? `${target}?${query}` : target;\n};\n\n//# sourceMappingURL=data:application/json;base64,"
