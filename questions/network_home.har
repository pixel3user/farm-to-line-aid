ebaseSignIn) {\n                try {\n                    console.log('Exchanging LIFF ID token for Firebase custom token...');\n                    const apiBaseUrl = resolveApiBaseUrl();\n                    const response = await fetch(`${apiBaseUrl}/api/auth/line`, {\n                        method: 'POST',\n                        headers: {\n                            'Content-Type': 'application/json'\n                        },\n                        body: JSON.stringify({\n                            idToken\n                        })\n                    });\n                    if (response.ok) {\n                        const authResult = await response.json();\n                        console.log('Custom token received, signing in to Firebase...');\n                        // Sign in to Firebase with custom token\n                        const { signInWithCustomToken } = await import(\"/node_modules/.vite/deps/firebase_auth.js?v=d6641df2\");\n                        const userCredential = await signInWithCustomToken(auth, authResult.customToken);\n                        firebaseUser = userCredential.user;\n                        console.log('Firebase authentication successful:', firebaseUser.uid);\n                    } else {\n                        console.error('Failed to exchange LIFF token:', response.status);\n                    }\n                } catch (authError) {\n                    console.error('Firebase authentication failed, continuing with local session:', authError);\n                }\n            } else if (idToken) {\n                console.log('Skipping Firebase custom token exchange for mock LINE token.');\n            }\n            const userRef = doc(db, 'line_users', profile.userId);\n            const userSnap = await getDoc(userRef);\n            if (!userSnap.exists()) {\n                console.log('Creating new user profile...');\n                const coords = await requestInitialLocation();\n                // Create new user\n                const newUser = {\n                    id: profile.userId,\n                    lineUserId: profile.userId,\n                    displayName: profile.displayName,\n                    pictureUrl: profile.pictureUrl || null,\n                    statusMessage: profile.statusMessage || null,\n                    createdAt: Timestamp.now(),\n                    updatedAt: Timestamp.now(),\n                    isActive: true,\n                    subscriptionTier: 'free',\n                    preferences: {\n                        language: 'zh-TW',\n                        notifications: true,\n                        marketingOptIn: false\n                    },\n                    metadata: {\n                        totalMessages: 0,\n                        lastInteraction: Timestamp.now(),\n                        favoriteFeatures: []\n                    },\n                    ...coords ? {\n                        location: {\n                            lat: coords.lat,\n                            lng: coords.lng,\n                            source: 'browser',\n                            updatedAt: Timestamp.now()\n                        }\n                    } : {}\n                };\n                // Only add email if present\n                if (profile.email) {\n                    newUser.email = profile.email;\n                }\n                await setDoc(userRef, newUser);\n                setUser(newUser);\n                // Load user data\n                try {\n                    await loadUserData(profile.userId);\n                } catch (loadError) {\n                    console.error('Failed to load user data:', loadError);\n                }\n            } else {\n                console.log('Updating existing user profile...');\n                // Update existing user\n                const existingUser = userSnap.data();\n                const updates = {\n                    displayName: profile.displayName,\n                    pictureUrl: profile.pictureUrl,\n                    statusMessage: profile.statusMessage,\n                    updatedAt: Timestamp.now(),\n                    'metadata.lastInteraction': Timestamp.now()\n                };\n                if (profile.email) {\n                    updates.email = profile.email;\n                }\n                await updateDoc(userRef, updates);\n                setUser({\n                    ...existingUser,\n                    displayName: profile.displayName,\n                    pictureUrl: profile.pictureUrl,\n                    statusMessage: profile.statusMessage,\n                    updatedAt: Timestamp.now()\n                });\n                // Load existing user data\n                try {\n                    await loadUserData(profile.userId);\n                } catch (loadError) {\n                    console.error('Failed to load user data:', loadError);\n                }\n            }\n            console.log('Firebase authentication completed successfully');\n            setIsLoading(false);\n        } catch (error) {\n            console.error('Firebase authentication failed:', error);\n            // Fallback: Create a LineUser from profile to allow app to proceed in demo mode\n            console.log('Creating fallback user for demo mode...');\n            const fallbackUser = {\n                id: profile.userId,\n                lineUserId: profile.userId,\n                displayName: profile.displayName,\n                pictureUrl: profile.pictureUrl || null,\n                statusMessage: profile.statusMessage || null,\n                createdAt: Timestamp.now(),\n                updatedAt: Timestamp.now(),\n                isActive: true,\n                subscriptionTier: 'free',\n                preferences: {\n                    language: 'zh-TW',\n                    notifications: true,\n                    marketingOptIn: false\n                },\n                metadata: {\n                    totalMessages: 0,\n                    lastInteraction: Timestamp.now(),\n                    favoriteFeatures: []\n                }\n            };\n            setUser(fallbackUser);\n            setIsLoading(false);\n            console.log('Fallback user created, app can proceed in demo mode');\n        }\n    };\n    const loginWithEmail = async (email, password)=>{\n        if (!auth || !db) throw new Error('Firebase not initialized');\n        try {\n            const { signInWithEmailAndPassword } = await import(\"/node_modules/.vite/deps/firebase_auth.js?v=d6641df2\");\n            const cred = await signInWithEmailAndPassword(auth, email, password);\n            const uid = cred.user.uid;\n            // Ensure unified profile exists keyed by LINE userId if present, else Firebase UID\n            // We will use a mapping: line_users doc id == uid for email-only accounts\n            const userRef = doc(db, 'line_users', uid);\n            const snap = await getDoc(userRef);\n            if (!snap.exists()) {\n                const now = Timestamp.now();\n                const coords = await requestInitialLocation();\n                const newUser = {\n                    id: uid,\n                    lineUserId: uid,\n                    displayName: cred.user.displayName || email.split('@')[0],\n                    pictureUrl: cred.user.photoURL || null,\n                    statusMessage: null,\n                    email,\n                    createdAt: now,\n                    updatedAt: now,\n                    isActive: true,\n                    subscriptionTier: 'free',\n                    preferences: {\n                        language: 'zh-TW',\n                        notifications: true,\n                        marketingOptIn: false\n                    },\n                    metadata: {\n                        totalMessages: 0,\n                        lastInteraction: now,\n                        favoriteFeatures: []\n                    },\n                    ...coords ? {\n                        location: {\n                            lat: coords.lat,\n                            lng: coords.lng,\n                            source: 'browser',\n                            updatedAt: now\n                        }\n                    } : {}\n                };\n                await setDoc(userRef, newUser);\n                setUser(newUser);\n            } else {\n                setUser(snap.data());\n            }\n        } finally{\n            setIsLoading(false);\n        }\n    };\n    const signUpWithEmail = async (email, password, displayName, role)=>{\n        if (!auth || !db) throw new Error('Firebase not initialized');\n        const { createUserWithEmailAndPassword, updateProfile } = await import(\"/node_modules/.vite/deps/firebase_auth.js?v=d6641df2\");\n        const cred = await createUserWithEmailAndPassword(auth, email, password);\n        if (displayName) {\n            await updateProfile(cred.user, {\n                displayName\n            });\n        }\n        // Create unified profile\n        const uid = cred.user.uid;\n        const now = Timestamp.now();\n        const userRef = doc(db, 'line_users', uid);\n        const coords = await requestInitialLocation();\n        const newUser = {\n            id: uid,\n            lineUserId: uid,\n            displayName: displayName || email.split('@')[0],\n            pictureUrl: cred.user.photoURL || null,\n            statusMessage: null,\n            email,\n            createdAt: now,\n            updatedAt: now,\n            isActive: true,\n            subscriptionTier: 'free',\n            preferences: {\n                language: 'zh-TW',\n                notifications: true,\n                marketingOptIn: false\n            },\n            metadata: {\n                totalMessages: 0,\n                lastInteraction: now,\n                favoriteFeatures: []\n            },\n            ...coords ? {\n                location: {\n                    lat: coords.lat,\n                    lng: coords.lng,\n                    source: 'browser',\n                    updatedAt: now\n                }\n            } : {}\n        };\n        if (role) {\n            newUser.role = role;\n            newUser.roleSelectedAt = now;\n        }\n        await setDoc(userRef, newUser);\n        setUser(newUser);\n    };\n    const loadUserData = async (userId)=>{\n        const now = Date.now();\n        const timeSinceLastLoad = now - lastLoadTimeRef.current;\n        if (dataLoadingRef.current) {\n            console.log('Data loading already in progress, skipping...');\n            return;\n        }\n        if (timeSinceLastLoad < 1000) {\n            console.log('Data loaded recently, skipping to prevent rapid calls...');\n            return;\n        }\n        try {\n            dataLoadingRef.current = true;\n            lastLoadTimeRef.current = now;\n            setIsRefreshingData(true);\n            console.log('Loading user data for:', userId);\n            console.log('Database connection status:', db ? 'Connected' : 'Not connected');\n            if (!db) {\n                console.warn('Firebase database not available during load, using demo data');\n                const defaultStats = {\n                    totalProducts: 0,\n                    totalStores: 0,\n                    totalConversations: 0,\n                    totalMarketingMaterials: 0,\n                    lastActivity: Timestamp.now(),\n                    activeProducts: 0,\n                    lowStockProducts: 0,\n                    totalRevenue: 0,\n                    monthlyGrowth: 0\n                };\n                setUserStats(defaultStats);\n                setUserProducts([]);\n                setUserStores([]);\n                setUserMarketingMaterials([]);\n                setIsLoading(false);\n                setIsRefreshingData(false);\n                return;\n            }\n            // Load user profile\n            const userRef = doc(db, 'line_users', userId);\n            const userSnap = await getDoc(userRef);\n            const userData = userSnap.exists() ? userSnap.data() : null;\n            const userRole = userData?.role;\n            if (userData) {\n                console.log('Loaded user profile:', userData.displayName);\n                setUser({\n                    ...userData,\n                    id: userData.id ?? userId,\n                    lineUserId: userData.lineUserId ?? userId\n                });\n            } else {\n                console.log('User profile not found, will be created during authentication');\n            }\n            // Debug database first (development only)\n            if (import.meta.env.DEV) {\n                await UserDataService.debugDatabase(userId);\n            }\n            // Load user statistics and data\n            console.log('Loading user statistics and data...');\n            const storesPromise = userRole === 'farmer' ? UserDataService.getStoresForFarmer(userId) : UserDataService.getUserStores(userId);\n            const [stats, products, stores, marketingMaterials] = await Promise.all([\n                UserDataService.getUserStats(userId),\n                UserDataService.getUserProducts(userId),\n                storesPromise,\n                UserDataService.getMarketingMaterials(userId, 10)\n            ]);\n            if (userRole === 'farmer') {\n                stats.totalStores = stores.length;\n            }\n            console.log('Loaded data:', {\n                stats: stats,\n                productsCount: products.length,\n                storesCount: stores.length,\n                materialsCount: marketingMaterials.length,\n                products: products,\n                stores: stores\n            });\n            // Set the loaded data (empty arrays if no data exists)\n            console.log('AuthContext: Setting state with loaded data');\n            console.log('AuthContext: Setting userStats:', stats);\n            console.log('AuthContext: Setting userProducts:', products);\n            console.log('AuthContext: Setting userStores:', stores);\n            console.log('AuthContext: Setting userMarketingMaterials:', marketingMaterials);\n            setUserStats(stats);\n            setUserProducts(products);\n            setUserStores(stores);\n            setUserMarketingMaterials(marketingMaterials);\n            console.log('AuthContext: State set successfully');\n            // Check if user has no data - don't create demo data for real users\n            const hasData = stats.totalProducts > 0 || stats.totalStores > 0;\n            if (!hasData) {\n                console.log('No data found for user, leaving datasets empty.');\n            }\n            setIsLoading(false);\n        } catch (error) {\n            console.error('Failed to load user data:', error);\n            setIsLoading(false);\n        } finally{\n            dataLoadingRef.current = false;\n            setIsRefreshingData(false);\n        }\n    };\n    const login = async (profileOverride, lineIdToken, options)=>{\n        if (lineIdToken) {\n            setLineIdToken(lineIdToken);\n        }\n        // Prevent re-entrancy/infinite loops\n        if (loginInProgressRef.current) {\n            console.log('Login already in progress, skipping...');\n            return;\n        }\n        // If we already have a user session, do not re-login\n        if (user && !options?.force) {\n            console.log('User already authenticated, skipping login');\n            return;\n        }\n        const shouldManageLoadingState = !isLoading;\n        if (shouldManageLoadingState) {\n            setIsLoading(true);\n        } else {\n            console.log('Login invoked while loading – proceeding with explicit authentication flow');\n        }\n        loginInProgressRef.current = true;\n        try {\n            const profileToUse = profileOverride ?? liffUser;\n            if (profileToUse && !options?.force) {\n                if (profileOverride) {\n                    setLiffUser(profileToUse);\n                }\n                await authenticateWithFirebase(lineIdToken ?? '', profileToUse);\n                return;\n            }\n            const liff = (await import(\"/node_modules/.vite/deps/@line_liff.js?v=d6641df2\")).default;\n            const liffId = import.meta.env.VITE_LIFF_ID;\n            if (!liffId || liffId === 'your-liff-id') {\n                console.error('LIFF ID not configured. Please configure VITE_LIFF_ID in your environment variables.');\n                throw new Error('LINE Login not configured. Please contact administrator.');\n            }\n            // Check if we're inside LINE app - if so, use LIFF login, not LINE Login\n            const inLineClient = isInLineApp || liff.isInClient?.();\n            if (inLineClient) {\n                // Inside LINE - use LIFF authentication only\n                if (isLiffReady) {\n                    console.log('Inside LINE app, using LIFF login');\n                    liff.login();\n                    return;\n                } else {\n                    // LIFF not ready yet, initialize it first\n                    console.log('Inside LINE app, initializing LIFF for login');\n                    await liff.init({\n                        liffId\n                    });\n                    setIsLiffReady(true);\n                    liff.login();\n                    return;\n                }\n            }\n            // Not inside LINE - check if we should use LINE Login (web) or LIFF web login\n            // Force LIFF web login when requested or when no profile is available\n            if (options?.force || !liffUser) {\n                await liff.init({\n                    liffId\n                });\n                liff.login();\n                return;\n            }\n            console.log('No LINE profile available. Please use LINE Login.');\n            throw new Error('Please use LINE Login to access your account.');\n        } finally{\n            loginInProgressRef.current = false;\n            if (shouldManageLoadingState) {\n                setIsLoading(false);\n            }\n        }\n    };\n    const logout = async ()=>{\n        try {\n            if (isInLineApp && isLiffReady) {\n                const liff = (await import(\"/node_modules/.vite/deps/@line_liff.js?v=d6641df2\")).default;\n                liff.logout();\n            }\n            if (auth) {\n                await signOut(auth);\n            }\n            // Clear all state and localStorage\n            setUser(null);\n            setLiffUser(null);\n            setLineIdToken(null);\n            setUserStats(null);\n            setUserProducts([]);\n            setUserStores([]);\n            setUserMarketingMaterials([]);\n            localStorage.removeItem('farm2market_user');\n            localStorage.removeItem('farm2market_liff_user');\n            localStorage.removeItem('farm2market_line_id_token');\n        } catch (error) {\n            console.error('Logout failed:', error);\n        }\n    };\n    const refreshUserData = React.useCallback(async ()=>{\n        const targetUserId = liffUserRef.current?.userId || userRef.current?.id;\n        if (targetUserId && !dataLoadingRef.current) {\n            console.log('Refreshing user data for:', targetUserId);\n            try {\n                await loadUserData(targetUserId);\n            } catch (error) {\n                console.error('Error refreshing user data:', error);\n            }\n        } else if (dataLoadingRef.current) {\n            console.log('Data loading already in progress, skipping refresh...');\n        } else {\n            console.warn('No user ID available for refresh');\n        }\n    }, []);\n    const updateUserProfile = async (updates)=>{\n        if (!user || !db) throw new Error('User not authenticated or database not available');\n        try {\n            const userRef = doc(db, 'line_users', user.id);\n            const updateData = {\n                ...updates,\n                updatedAt: Timestamp.now()\n            };\n            await updateDoc(userRef, updateData);\n            // Update local user state\n            setUser((prev)=>prev ? {\n                    ...prev,\n                    ...updateData\n                } : null);\n        } catch (error) {\n            console.error('Failed to update user profile:', error);\n            throw error;\n        }\n    };\n    const updateUserPreferences = async (preferences)=>{\n        if (!user || !db) throw new Error('User not authenticated or database not available');\n        try {\n            const userRef = doc(db, 'line_users', user.id);\n            const updateData = {\n                preferences: {\n                    ...user.preferences,\n                    ...preferences\n                },\n                updatedAt: Timestamp.now()\n            };\n            await updateDoc(userRef, updateData);\n            // Update local user state\n            setUser((prev)=>prev ? {\n                    ...prev,\n                    preferences: {\n                        ...prev.preferences,\n                        ...preferences\n                    },\n                    updatedAt: Timestamp.now()\n                } : null);\n        } catch (error) {\n            console.error('Failed to update user preferences:', error);\n            throw error;\n        }\n    };\n    const value = {\n        user,\n        firebaseUser,\n        liffUser,\n        lineIdToken,\n        isLoading,\n        isRefreshingData,\n        isLiffReady,\n        isInLineApp,\n        login,\n        loginWithEmail,\n        signUpWithEmail,\n        logout,\n        refreshUserData,\n        setLiffProfile: (profile)