            "mimeType": "text/javascript",
            "compression": 0,
            "text": "export const POST_ONBOARDING_REDIRECT_KEY = 'farm2market_post_onboarding_redirect';\nexport const buildPostOnboardingRedirectPath = (location)=>{\n    const search = location.search ?? '';\n    const hash = location.hash ?? '';\n    return `${location.pathname}${search}${hash}`;\n};\nexport const isAuthRoute = (path)=>path.startsWith('/auth');\nexport const savePostOnboardingRedirect = (path)=>{\n    if (typeof window === 'undefined') return;\n    if (!path || isAuthRoute(path)) return;\n    if (!sessionStorage.getItem(POST_ONBOARDING_REDIRECT_KEY)) {\n        sessionStorage.setItem(POST_ONBOARDING_REDIRECT_KEY, path);\n    }\n};\nexport const getPostOnboardingRedirect = ()=>{\n    if (typeof window === 'undefined') return null;\n    return sessionStorage.getItem(POST_ONBOARDING_REDIRECT_KEY);\n};\nexport const clearPostOnboardingRedirect = ()=>{\n    if (typeof window === 'undefined') return;\n    sessionStorage.removeItem(POST_ONBOARDING_REDIRECT_KEY);\n};\nexport const consumePostOnboardingRedirect = ()=>{\n    const redirect = getPostOnboardingRedirect();\n    if (redirect) {\n        clearPostOnboardingRedirect();\n    }\n    return redirect;\n};\nexport const isRedirectAllowedForRole = (path, role)=>{\n    if (!path || isAuthRoute(path)) return false;\n    if (!role) return true;\n    if (path.startsWith('/market') && role !== 'market') return false;\n    if (path.startsWith('/farmer') && role !== 'farmer') return false;\n    return true;\n};\n\n//# sourceMappingURL=data:application/json;base64,"
