# LINE Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_bot_channel_secret
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret
LIFF_URL=https://your-app-url.com
LINE_RICHMENU_ONBOARDING_ID=richmenu-onboarding-id
LINE_RICHMENU_FARMER_ID=richmenu-farmer-id
LINE_RICHMENU_MARKET_ID=richmenu-market-id
VITE_LIFF_ID=your_liff_id
LINE_PAY_CHANNEL_ID=your_line_pay_channel_id
LINE_PAY_CHANNEL_SECRET=your_line_pay_channel_secret
LINE_PAY_SANDBOX=true

# LINE Login Configuration (for web authentication)
VITE_LINE_CHANNEL_ID=your_line_channel_id_here

# Gemini API
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_DEBUG=false

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
FIREBASE_SERVICE_ACCOUNT_KEY=base64_or_json_service_account

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:3000

# Map Integration (Optional)
VITE_MAPBOX_TOKEN=your-mapbox-token

# API Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_FRONTEND_BASE_URL=http://localhost:8080
VITE_VOICE_RELAY_URL=https://voice-relay-xyz.run.app

# Geocoding (server-side)
GEOCODING_PROVIDER=google
GEOCODING_API_KEY=your_geocoding_api_key
GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json

# Yamato (Black Cat) Logistics
YAMATO_ENV=test
YAMATO_BASE_URL=https://egs.suda.com.tw:8443/api/Egs
YAMATO_CUSTOMER_ID=your_contract_customer_id
YAMATO_CUSTOMER_TOKEN=your_contract_customer_token
YAMATO_TIMEOUT_MS=120000

# Yamato maps (optional overrides)
YAMATO_B2S_MAP_URL=http://egs.suda.com.tw:8080/Map.aspx
YAMATO_B2S_MOBILE_MAP_URL=http://egs.suda.com.tw:8080/MobileMap.aspx
YAMATO_PICKUP_MAP_URL=http://61.57.232.216/TCAT/CAT0001/CAT0001MM1
YAMATO_PICKUP_UID=your_uid
YAMATO_PICKUP_CUST_NO=your_customer_no
YAMATO_PICKUP_PKEY=your_pkey
